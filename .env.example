# ── 阶段 0：消费方连接底盘 ──────────────────────────────
# 不设 MH_BASE_URL 时 npm run smoke:consumer 会 SKIP exit 2（不挂 CI）
MH_BASE_URL=http://127.0.0.1:8080
# 可选 Bearer；/health 豁免。留空表示不启用
MH_HTTP_TOKEN=
MH_PRINCIPAL=parent
MH_BANK=home

# ── 阶段 1：在【底盘 repo】里跑 npm run smoke:llm 时使用 ──
# 这些变量属于 HomeServiceAI 仓库，不在本消费方仓库使用，仅作提醒。
# 密钥只放本地 .env，绝不进仓库 / 对话 / CI Secrets。
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_LOCAL_ENDPOINT=http://127.0.0.1:11434
